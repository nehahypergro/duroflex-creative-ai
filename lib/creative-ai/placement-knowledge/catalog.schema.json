{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:creative-ai:placement-knowledge:catalog.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "verifiedAt": {
      "type": "string",
      "format": "date"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "placement": {
            "type": "string",
            "minLength": 1
          },
          "assetType": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "market": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          },
          "useCase": {
            "type": "string",
            "minLength": 1
          },
          "certification": {
            "type": "string",
            "minLength": 1
          },
          "coverageStatus": {
            "enum": [
              "included",
              "conditional",
              "unavailable"
            ]
          },
          "verifiedAt": {
            "type": "string",
            "format": "date"
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slot": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "embeddedText": {
                  "enum": [
                    "allowed",
                    "discouraged",
                    "inherent-only",
                    "promotional-forbidden"
                  ]
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "slot",
                "role",
                "embeddedText",
                "required"
              ],
              "additionalProperties": false
            }
          },
          "nativeFields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "required": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "role": {
                  "type": "string",
                  "minLength": 1
                },
                "embedded": {
                  "const": false
                },
                "platformSupplied": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "required",
                "role",
                "embedded"
              ],
              "additionalProperties": false
            }
          },
          "ruleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "requiredJobInputs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "contentVerifiedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "verificationNote": {
            "type": "string",
            "minLength": 1
          },
          "canvas": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "enum": [
                  "px",
                  "mm",
                  "in"
                ]
              },
              "ratio": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "certification": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "width",
              "height",
              "unit"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "version",
          "family",
          "channel",
          "platform",
          "publisher",
          "placement",
          "assetType",
          "name",
          "market",
          "coverageStatus",
          "verifiedAt",
          "assets",
          "nativeFields",
          "ruleIds",
          "unknowns",
          "requiredJobInputs",
          "sourceIds",
          "notes",
          "useCase",
          "certification"
        ],
        "additionalProperties": false
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "enum": [
              "mandatory",
              "official-guidance",
              "heuristic"
            ]
          },
          "severity": {
            "enum": [
              "error",
              "warning",
              "advisory"
            ]
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "object",
            "properties": {
              "profileIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "profileIds"
            ],
            "additionalProperties": false
          },
          "check": {
            "type": "object",
            "properties": {
              "method": {
                "enum": [
                  "dimensions",
                  "file",
                  "asset-count",
                  "native",
                  "scalar",
                  "rendered-review",
                  "semantic-review",
                  "metadata-review",
                  "job-input"
                ]
              },
              "slot": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "exact": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "allowedSizes": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "min": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                ]
              },
              "max": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                ]
              },
              "ratios": {
                "type": "array",
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "ratioTolerance": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "recommended": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "maxMegapixels": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "formats": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "rejectedFormats": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "maxSize": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "unit": {
                    "enum": [
                      "B",
                      "KB",
                      "MB"
                    ]
                  },
                  "byteBase": {
                    "enum": [
                      null,
                      1000,
                      1024
                    ]
                  },
                  "exclusive": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "value",
                  "unit",
                  "byteBase"
                ],
                "additionalProperties": false
              },
              "minItems": {
                "type": "integer",
                "minimum": 0
              },
              "maxItems": {
                "type": "integer",
                "minimum": 1
              },
              "maxChars": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "countMethod": {
                "type": "string",
                "minLength": 1
              },
              "allowedSchemes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "readingPolicy": {
                "type": "object"
              },
              "minShortItems": {
                "type": "integer",
                "minimum": 1
              },
              "shortMaxChars": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "method"
            ],
            "additionalProperties": false
          },
          "verifiedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "versionDate": {
            "type": "string",
            "format": "date"
          },
          "confidence": {
            "type": "string",
            "minLength": 1
          },
          "evidenceStatus": {
            "enum": [
              "verified-primary",
              "verified-excerpt",
              "editorial-heuristic",
              "unknown",
              "source-conflict",
              "user-specified"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "limits": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "version",
          "tier",
          "severity",
          "sourceIds",
          "statement",
          "scope",
          "check",
          "verifiedAt",
          "versionDate",
          "confidence",
          "evidenceStatus",
          "rationale",
          "limits"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "tier": {
                  "const": "mandatory"
                }
              }
            },
            "then": {
              "properties": {
                "severity": {
                  "const": "error"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "tier": {
                  "const": "official-guidance"
                }
              }
            },
            "then": {
              "properties": {
                "severity": {
                  "const": "warning"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "tier": {
                  "const": "heuristic"
                }
              }
            },
            "then": {
              "properties": {
                "severity": {
                  "const": "advisory"
                }
              }
            }
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "enum": [
              "primary",
              "editorial",
              "user"
            ]
          },
          "accessStatus": {
            "enum": [
              "verified-content",
              "verified-search-excerpt",
              "unavailable",
              "editorial",
              "user-provided"
            ]
          },
          "accessCheckedAt": {
            "type": "string",
            "format": "date"
          },
          "verifiedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "sourceVersion": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "limitations": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "publisher",
          "authority",
          "accessStatus",
          "accessCheckedAt",
          "verifiedAt",
          "sourceVersion",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "sourceConflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "sourceIds",
          "resolution"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "verifiedAt",
    "profiles",
    "rules",
    "sources",
    "sourceConflicts"
  ],
  "additionalProperties": false
}
