# Configure through your deployment secret manager. Do not commit populated files.
CREATIVE_AI_EXECUTION_BACKEND=postgres
CREATIVE_AI_DATABASE_URL=postgresql://WORKER_USER:SECRET@DATABASE_HOST/creative
CREATIVE_AI_ARTIFACT_BUCKET=PRIVATE_BUCKET_NAME
AWS_REGION=ap-south-1
