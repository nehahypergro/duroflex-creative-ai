# CREATIVE_AI_S3_PATH_STYLE=1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# CREATIVE_AI_DATABASE_CA=PEM_CA_CONTENT
OPENAI_API_KEY=
