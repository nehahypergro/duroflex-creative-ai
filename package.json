{
  "name": "duroflex-group-creative-ai",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Independent Duroflex group Creative AI studio with isolated Duroflex and Sleepyhead workspaces",
  "scripts": {
    "start": "node server.js",
    "test:replay": "node scripts/creative-ai/replay-handoffs.js",
    "test:qa:recorded": "node scripts/creative-ai/qa-recorded-provider.js",
    "test:qa:digital": "node scripts/creative-ai/qa-digital-matrix.js",
    "test:qa:performance": "node scripts/creative-ai/qa-handoff-performance.js",
    "test": "node --require ./tests/creative-ai/offline-bootstrap.cjs --test tests/creative-ai/*.test.js tests/group-workspace.test.js",
    "test:qa:sleepyhead-next-run": "node scripts/creative-ai/qa-sleepyhead-next-run.js",
    "test:qa:duroflex-next-run": "node scripts/creative-ai/qa-brand-next-run.js --brand=Duroflex --job=creative-8e57a041-f219-4be2-afce-15a7a97f4b3a",
    "test:qa:both-brands": "node scripts/creative-ai/qa-both-brands.js",
    "test:qa:sku-matrix": "node scripts/creative-ai/qa-random-sku-matrix.js",
    "media:manifest": "node scripts/creative-ai/cdn-portability.js export",
    "media:restore": "node scripts/creative-ai/cdn-portability.js restore",
    "start:admin": "node admin-server.js",
    "test:admin": "node --test tests/admin/*.test.js",
    "test:client-readiness": "node scripts/admin/verify-client-readiness.js"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "fontkit": "2.0.4",
    "mongodb": "6.21.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "8.23.1",
    "playwright-core": "1.58.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "embedded-postgres": "18.4.0-beta.17",
    "mongodb-memory-server": "10.4.3"
  }
}
