OPENAI_API_KEY=
# Dedicated studio: Luna for text/vision reasoning; image generation remains gpt-image-2.
CREATIVE_AI_REASONING_MODEL=gpt-6-luna
CREATIVE_AI_MAX_ESTIMATED_USD=100
# Leave local until hosting and team authentication are implemented.
HOST=127.0.0.1
PORT=1842

# Optional Studio concurrency. Defaults: 2 / 2 / 2 / 4.
# CREATIVE_AI_PLANNING_JOBS=3
# CREATIVE_AI_IMAGE_JOBS=3
# CREATIVE_AI_MAX_IMAGE_CALLS=4
# CREATIVE_AI_MAX_REASONING_CALLS=6
# Optional per-call time limits in milliseconds. Defaults: 240000 (planning) / 240000 (review) / 90000 (queued).
# CREATIVE_AI_PLANNING_CALL_LIMIT_MS=240000
# CREATIVE_AI_QUEUED_LIMIT_MS=90000
# CREATIVE_AI_BRIEF_READ_EFFORT=low
# CREATIVE_AI_REVIEW_CALL_LIMIT_MS=240000
